<!doctype html><html lang="sv"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ETA Navigator</title><style>:root{font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#e9f3fc;background:#071522}*{box-sizing:border-box}body{margin:0;padding:28px 14px;background:radial-gradient(circle at top right,#143a53,#071522 60%);min-height:100vh}.wrap{max-width:850px;margin:auto}.top{display:flex;align-items:center;gap:12px;margin-bottom:24px}.logo{font-size:32px;background:#12334b;padding:12px;border-radius:15px}h1{margin:0;font-size:27px}small,.muted{color:#9bb4c6}.card{background:#102537;border:1px solid #2a4658;border-radius:20px;padding:24px;margin:16px 0;box-shadow:0 12px 35px #0002}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}label{display:block;color:#b9cedd;font-size:14px;margin-bottom:7px}input,select{width:100%;border:1px solid #456174;background:#071b2b;color:white;border-radius:11px;padding:13px;font-size:18px;min-width:0}input:focus,select:focus{outline:2px solid #48b9d3}.result{background:linear-gradient(125deg,#12445a,#126777);border-color:#328a9c}.eyebrow{font-size:13px;letter-spacing:1.4px;color:#bce7ee;font-weight:700}.eta{font-size:clamp(38px,9vw,65px);font-weight:800;letter-spacing:-2px;margin:5px 0}.stats{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:20px}.stat{background:#ffffff13;border-radius:13px;padding:14px}.stat strong{font-size:22px;display:block;margin-top:5px}button{background:#37b7ca;border:0;border-radius:10px;color:#05202a;font-weight:750;padding:12px 16px;cursor:pointer}button.secondary{background:#234457;color:#e8f4fa}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:15px}.note{font-size:13px;line-height:1.6;color:#9eb9c9}.error{color:#ffbdac}.comparison{display:grid;grid-template-columns:1fr 1fr;gap:14px}.comparison strong{font-size:20px}.comparison>div{background:#071b2b;padding:14px;border-radius:12px}@media(max-width:530px){.grid,.comparison{grid-template-columns:1fr}.card{padding:18px}.stats{gap:8px}}</style></head><body><main class="wrap"><header class="top"><div class="logo">⚓</div><div><h1>ETA Navigator</h1><small>Maritim ankomst- och gångtidskalkylator</small></div></header><section class="card"><div class="grid"><div><label for="distance">Återstående distans (NM)</label><input id="distance" type="number" min="0" step="any" value="42" inputmode="decimal"></div><div><label for="speed">Fart över grund, SOG (knop)</label><input id="speed" type="number" min="0" step="any" value="12" inputmode="decimal"></div><div><label for="start">Beräkning från datum och tid</label><input id="start" type="datetime-local"></div><div><label for="zone">Tidsvisning</label><select id="zone"><option value="local">Enhetens lokala tid</option><option value="utc">UTC</option></select></div></div><div class="actions"><button id="now">Använd aktuell tid</button><button class="secondary" id="copy">Kopiera beräkning</button></div></section><section class="card result" aria-live="polite"><div class="eyebrow">BERÄKNAD ANKOMST · ETA</div><div class="eta" id="eta">—</div><div id="date" class="muted" style="color:#d5eef3">—</div><div class="stats"><div class="stat"><span>Återstående gångtid</span><strong id="duration">—</strong></div><div class="stat"><span>Distans / fart</span><strong id="summary">—</strong></div></div><p id="error" class="error"></p></section><section class="card"><h2 style="margin-top:0;font-size:20px">Jämför annan fart</h2><div class="grid"><div><label for="alternate">Alternativ fart (knop)</label><input id="alternate" type="number" min="0" step="any" value="15"></div><div><label>Skillnad mot ordinarie ETA</label><div id="difference" style="font-size:21px;font-weight:700;padding:12px 0">—</div></div></div><div class="comparison" style="margin-top:12px"><div><span class="muted">Alternativ ETA</span><br><strong id="alteta">—</strong></div><div><span class="muted">Alternativ gångtid</span><br><strong id="altduration">—</strong></div></div></section><p class="note">Beräkningen utgår från konstant fart över grund (SOG) längs återstående färdväg. Den tar inte automatiskt hänsyn till ström, väder, fartändringar, väntetider eller manövrering. Använd som planeringshjälp, inte som ersättning för navigationsutrustning eller reseplanering. All beräkning sker lokalt i webbläsaren – ingen uppkoppling behövs.</p></main><script>const $=id=>document.getElementById(id);const inputs=['distance','speed','start','zone','alternate'];function localInput(d){const pad=n=>String(n).padStart(2,'0');return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`}function setNow(){$('start').value=localInput(new Date());calculate()}function fmt(d,options){return new Intl.DateTimeFormat('sv-SE',{timeZone:$('zone').value==='utc'?'UTC':undefined,...options}).format(d)}function duration(minutes){const m=Math.round(minutes);const days=Math.floor(m/1440),hours=Math.floor(m%1440/60),mins=m%60;return [days?days+' dygn':null,hours?hours+' tim':null,mins+' min'].filter(Boolean).join(' ')}function etaDate(d){return fmt(d,{weekday:'long',day:'numeric',month:'long',year:'numeric'})+($('zone').value==='utc'?' · UTC':' · lokal tid')}function clock(d){return fmt(d,{hour:'2-digit',minute:'2-digit',hourCycle:'h23'})}function calculate(){const dist=Number($('distance').value),speed=Number($('speed').value),alt=Number($('alternate').value),start=new Date($('start').value),valid=$('distance').value!==''&&dist>=0&&speed>0&&Number.isFinite(start.getTime());$('error').textContent=valid?'':'Ange en giltig distans, fart över 0 knop och starttid.';if(!valid){['eta','date','duration','summary','difference','alteta','altduration'].forEach(x=>$(x).textContent='—');return}const mins=dist/speed*60;const arrival=new Date(start.getTime()+mins*60000);$('eta').textContent=clock(arrival);$('date').textContent=etaDate(arrival);$('duration').textContent=duration(mins);$('summary').textContent=`${dist.toLocaleString('sv-SE')} NM / ${speed.toLocaleString('sv-SE')} kn`;if(alt>0&&$('alternate').value!==''){const altmins=dist/alt*60,altarrival=new Date(start.getTime()+altmins*60000);$('alteta').textContent=clock(altarrival)+' · '+fmt(altarrival,{day:'numeric',month:'short'});$('altduration').textContent=duration(altmins);const diff=Math.round(Math.abs(mins-altmins));$('difference').textContent=diff===0?'Samma ETA':duration(diff)+(alt>speed?' tidigare':' senare')}else{['difference','alteta','altduration'].forEach(x=>$(x).textContent='—')}}inputs.forEach(id=>$(id).addEventListener('input',calculate));$('now').addEventListener('click',setNow);$('copy').addEventListener('click',async()=>{const value=`ETA: ${$('eta').textContent}, ${$('date').textContent}\nGångtid: ${$('duration').textContent}\nDistans/fart: ${$('summary').textContent}`;try{await navigator.clipboard.writeText(value);$('copy').textContent='Kopierat!';setTimeout(()=>$('copy').textContent='Kopiera beräkning',1800)}catch{window.prompt('Kopiera:',value)}});setNow();</script></body></html>
